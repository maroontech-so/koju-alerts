# Telegram user account (Telethon) — create a StringSession locally; never commit it.
API_ID=
API_HASH=
SESSION_STRING=

# Telegram subscriber bot from BotFather
BOT_TOKEN=

# Groq classification
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CONFIDENCE_THRESHOLD=0.75

# Source channel
CHANNEL_USERNAME=kojoforextrades

# Firebase Admin SDK (entire service-account JSON on one line)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FCM_TOPIC=kojo-alerts

# Storage and logging
DATABASE_PATH=./data/kojo_alerts.sqlite3
LOG_LEVEL=INFO
